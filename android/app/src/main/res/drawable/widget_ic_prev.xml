<?xml version="1.0" encoding="utf-8"?>
<!-- «قبلی» — a chevron pointing at the RIGHT edge, which is where «previous»
     lives in an RTL layout. Tinted at render time by WidgetArt.tintedIcon, so
     the fill colour here is irrelevant (it is always overridden). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,6 L15,12 L9,18"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
