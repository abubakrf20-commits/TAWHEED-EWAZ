<?xml version="1.0" encoding="utf-8"?>
<!--
  The prayer card's COMPACT tier (cells under PrayerWidgetBudget.SMALL_MAX_HEIGHT_DP):
  the live clock, the city, one date line, the hijri line, the countdown —
  everything the old compact Glance card carried, on the same hand-built
  RemoteViews architecture as widget_prayer_native.xml.

  Same contract: no fixed dp sizes that matter, everything bound by
  PrayerNativeViews from one budget; the ids shared with the full card
  (prayer_native_root, prayer_surface, prayer_content, prayer_clock_slot,
  prayer_countdown_prefix, prayer_countdown) keep the code paths identical.
  The full card's capsule ids are absent here BY DESIGN — a compact card has
  no capsule taps, so a tap partial update is never sent to it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_native_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/prayer_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/prayer_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- The live clock leaf (see PrayerRemoteLeaves). Centred, wrap_content. -->
        <FrameLayout
            android:id="@+id/prayer_clock_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/prayer_small_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/calibri"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/prayer_small_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/calibri"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/prayer_small_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/calibri"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <!-- The compact card's hairline divider. A plain <View> is not in
             RemoteViews' view whitelist (measured on HyperOS, 2026-11-04), so
             a zero-content FrameLayout carries the line instead; its WIDTH is
             the one fixed dimension kept (a decorative flourish, not
             information) and its colour is bound by code. -->
        <FrameLayout
            android:id="@+id/prayer_small_divider"
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <!-- «تا اذان صبح  ۸:۴۷:۴۴» — caption and value at the SAME type size,
             centred as one row (brief: «یک سایز باشند فونتشون ووسط قرار
             بگیرند نه سمت راست»). -->
        <LinearLayout
            android:id="@+id/prayer_countdown_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prayer_countdown_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/calibri"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/prayer_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:fontFamily="@font/calibri"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/prayer_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/calibri"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
