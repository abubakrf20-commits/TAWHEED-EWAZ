<?xml version="1.0" encoding="utf-8"?>
<!-- An empty icon for the Android 12+ system splash, which cannot be
     suppressed at all: the only thing the app decides is what it draws. A mark
     here would be a SECOND logo — the OS sizes and masks it as it likes, above
     the real splash — so the system window is left as bare field and the coin
     belongs to the Flutter frame alone.

     A transparent drawable, NOT @null: with the attribute unset or null the
     framework falls back to the application launcher icon, which is exactly
     the mark this replaces. The 1dp intrinsic size keeps the icon view from
     reserving any space in the window. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <size
        android:width="1dp"
        android:height="1dp"/>
</shape>
